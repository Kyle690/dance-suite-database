model section_dancers {
  uid        String              @id @unique @default(uuid()) @db.Uuid
  created    DateTime            @default(now())
  updated    DateTime            @updatedAt
  section_id String              @db.Uuid
  section    sections            @relation(fields: [section_id], references: [uid], onDelete: Cascade)
  dancer_id  String              @db.Uuid
  dancer     competition_dancers @relation(fields: [dancer_id], references: [uid], onDelete: Cascade)

  // relationships
  heat_dancers heat_dancers[]

  @@index([section_id], name: "section_dancers_section_id_idx")
  @@index([dancer_id], name: "section_dancers_dancer_id_idx")
}