model heat_dancers {
  uid       String          @id @unique @default(uuid()) @db.Uuid
  created   DateTime        @default(now())
  updated   DateTime        @updatedAt
  heat_id   String          @db.Uuid
  heat      heat            @relation(fields: [heat_id], references: [uid], onDelete: Cascade)
  dancer_id String          @db.Uuid
  dancer    section_dancers @relation(fields: [dancer_id], references: [uid], onDelete: Cascade)

  @@index([heat_id], name: "heat_dancers_heat_id_idx")
  @@index([dancer_id], name: "heat_dancers_dancer_id_idx")
}